# ═══════════════════════════════════════════════════════════════
#  BLACK DEMON Bot — Environment Variables
#  Rename this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Session (REQUIRED to avoid QR on every restart) ───────────
# Get this from the gifted-session website:
#   1. Deploy gifted-session (or use the public site)
#   2. Open /pair, enter your WhatsApp number
#   3. Enter the pairing code in WhatsApp → Linked Devices
#   4. Copy the SESSION_ID and paste it below
SESSION=GIFTED-MD~paste_your_session_id_here

# ── Owner number (no + sign, include country code) ────────────
DEV=254769365617

# ── Bot behaviour ──────────────────────────────────────────────
PREFIX=.
MODE=PUBLIC
BOTNAME=BLACK-DEMON

# ── Feature switches (TRUE / FALSE) ───────────────────────────
AUTOBIO=FALSE
AUTOVIEW_STATUS=TRUE
AUTOLIKE_STATUS=TRUE
AUTOREAD=FALSE
AUTOREJECT_CALL=TRUE
ANTIDELETE=TRUE
ANTIBOT=FALSE
ANTITAG=TRUE
ANTILINK=TRUE
ANTILINK_ALL=FALSE
ANTIFOREIGN=FALSE
WELCOMEGOODBYE=TRUE
GPT_INBOX=FALSE
BAD_WORD_KICK=FALSE
BAD_WORD=fuck

# ── Bot presence ──────────────────────────────────────────────
WA_PRESENCE=online

# ── Sticker metadata ──────────────────────────────────────────
STICKER_PACKNAME=BLACK-DEMON
STICKER_AUTHOR=Jinwiil Onginjo

# ── Menu style ────────────────────────────────────────────────
MENU_TYPE=IMAGE
MENU_LINK=https://files.catbox.moe/m38sqm.jpg

# ── Anti-foreign ─────────────────────────────────────────────
CODE=254

# ── Heroku (only needed for .redeploy command) ────────────────
APP_NAME=
HEROKU_API=

# ── Port ──────────────────────────────────────────────────────
PORT=3000
